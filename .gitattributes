# نرمال‌سازی خط پایان: در مخزن فقط LF می‌ماند، حتی اگر ویندوزی‌ها CRLF بفرستند.
* text=auto eol=lf

# فایل‌های متنی که حتماً LF می‌خواهند
*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.sh    text eol=lf
*.conf  text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.txt   text eol=lf
.env.example    text eol=lf
nobatin.env.template text eol=lf

# باینری: هرگز دست‌نخورده بماند و در diff باز نشود
*.woff2 binary
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
*.db    binary
*.sqlite binary

# زبان‌ها برای رنگی‌کردن diff و آمار زبان GitHub
*.py    linguist-language=Python
*.html  linguist-language=HTML
*.jinja linguist-language=HTML
