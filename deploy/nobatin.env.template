# نوبتین — تنظیمات سرور. این فایل را /srv/nobatin/.env بگذارید.
# حقِ دسترسی: systemd این فایل را پیش از پایین‌آمدن به کاربر nobatin و به‌عنوان root
# می‌خواند، پس مالک root:root و chmod 600 درست‌ترین حالت است — خودِ فرآیند اپ به آن
# نیازی ندارد (هیچ وابستگیِ .env در پروژه نیست؛ همه‌چیز از EnvironmentFile می‌آید).
# هیچ‌وقت مقدار واقعی NOBATIN_SECRET یا KAVENEGAR_KEY را در git نگذارید.

# ---------- حالت اجرا ----------
NOBATIN_ENV=production
# بسازید:  python -c "import secrets; print(secrets.token_urlsafe(48))"
NOBATIN_SECRET=
# دامنهٔ واقعی، جدا شده با ویرگول.
# در production خالی گذاشتنش یعنی برنامه اصلاً بالا نمی‌آید (عمداً؛ وگرنه مهاجم با
# هدر Host جعلی، پیوندهای داخل پیامک‌ها را به دامنهٔ خودش می‌سازد).
# تطابق دقیق است؛ «.example.com» خودِ دامنه و همهٔ زیردامنه‌ها را می‌پذیرد.
# localhost و 127.0.0.1 خودکار مجازند تا بررسی سلامتِ محلی با curl کار کند.
# نشانی IPv6 داخل [] پذیرفته نمی‌شود (محدودیت werkzeug).
NOBATIN_TRUSTED_HOSTS=example.com,www.example.com
# سایت پشت nginx است، پس IP و http/https واقعی از X-Forwarded-* خوانده می‌شود
NOBATIN_BEHIND_PROXY=1
# کوکی فقط با HTTPS (روی http محلی ۰ بگذارید وگرنه ورود کار نمی‌کند)
NOBATIN_COOKIE_SECURE=1
# ساعت عمر نشست ورود
NOBATIN_SESSION_HOURS=12

# ---------- دیتابیس ----------
# نام فایل داخل instance/ (یا مسیر مطلق)
NOBATIN_DB=nobatin.db
NOBATIN_TX_RETRIES=4

# ---------- اولین مدیر ----------
# در production دادهٔ نمونه ساخته نمی‌شود؛ با این شماره اولین حساب مدیر می‌شود
NOBATIN_SEED=0
NOBATIN_ADMIN_MOBILE=
NOBATIN_ADMIN_NAME=مدیر نوبتین

# ---------- ورود و پیامک ----------
# NOBATIN_OTP_MASTER در production مجاز نیست (اپ بالا نمی‌آید) — نگذاریدش.
NOBATIN_OTP_COOLDOWN=60
NOBATIN_OTP_MAX_MOBILE=5
NOBATIN_OTP_MAX_IP=12
NOBATIN_OTP_MAX_ATTEMPTS=12
# log = فقط ثبت؛ kavenegar = ارسال واقعی
NOBATIN_SMS_PROVIDER=log
KAVENEGAR_KEY=
KAVENEGAR_SENDER=
# در production متن پیامکِ ثبت‌شده در sms_log از کدِ زندهٔ OTP پاک‌سازی می‌شود
# (پیش‌فرض: روشن). پنل «پیامک‌ها» در دستِ مدیران است و نباید رمزِ در جریانِ ورود
# آنجا خوانده شود؛ اگر واقعاً برای عیب‌یابی کد خام می‌خواهید =0 بگذارید.
NOBATIN_SMS_MASK_OTP=1
NOBATIN_REMINDER_MINUTES=10

# ---------- پرداخت ----------
# sandbox = درگاه آزمایشی داخل پروژه؛ برای پول واقعی اتصال درگاه لازم است
NOBATIN_PAYMENT_PROVIDER=sandbox
# با درگاه آزمایشی در production اپ بالا نمی‌آید، چون هر کاربر واردشده می‌تواند
# «پرداخت موفق» بزند و نوبت رایگان قطعی کند. دو راه درست:
#   ۱) درگاه واقعی وصل کنید (NOBATIN_PAYMENT_PROVIDER=…).
#   ۲) فقط برای محیط نمایشی/دموی زنده، صریحاً اجازه بدهید:
# NOBATIN_ALLOW_SANDBOX=1
NOBATIN_ALLOW_SANDBOX=0
# تنها جای استثنا برای CSRF: endpointی که سرویس بیرونی (درگاه واقعی) سرور‌به‌سرور
# POST می‌کند. بازگشتِ درگاه *آزمایشی* این پروژه فرمِ خودمان است و توکن می‌فرستد،
# پس اینجا چیزی لازم ندارد؛ gateway.pay را بدون درگاه واقعی exempt نکنید.
NOBATIN_CSRF_EXEMPT=

# ---------- سقف‌های نرخ (ضد ربات) ----------
NOBATIN_LIMIT_WRITES_PER_MIN=90
NOBATIN_LIMIT_HOLDS_PER_HOUR=120
NOBATIN_LIMIT_BOOKINGS_PER_HOUR=30
NOBATIN_LIMIT_BIZ_PER_DAY=10
NOBATIN_MAX_BODY_KB=1024

# ---------- کش و نگهداری ----------
NOBATIN_CACHE_TTL=15
NOBATIN_HOUSEKEEPING_SECONDS=20
NOBATIN_STATIC_MAX_AGE=604800

# ---------- سرصفحه‌های امنیتی ----------
NOBATIN_HSTS_SECONDS=31536000
# پیش‌فرض پروژه اسکریپت درون‌خطی را ممنوع می‌کند؛ فقط در صورت نیاز عوض کنید
# (style-src درون‌خطی لازم است: رنگ هر کسب‌وکار با متغیر --biz-hue ست می‌شود).
NOBATIN_CSP=

# ---------- سلامت و لاگ ----------
NOBATIN_HEALTHZ=1
# فقط از این IPها (پیش‌فرض loopback). برای بررسی از بیرون — مثلاً uptime robot — یک
# توکن بلند تصادفی بگذارید و از سرصفحه بفرستید، نه از query:
#   curl -H "X-Health-Token: $TOKEN" https://example.com/healthz
# نشانیِ ?token=… در لاگ nginx و در تاریخچهٔ مرورگر می‌نشیند؛ سرصفحه نمی‌نشیند.
NOBATIN_HEALTHZ_TOKEN=
NOBATIN_HEALTHZ_ALLOW=127.0.0.1,::1
NOBATIN_LOG_FILE=/var/log/nobatin/app.log
NOBATIN_LOG_LEVEL=INFO
