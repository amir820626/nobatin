# نوبتین — نمونهٔ متغیرهای محیطی
# این فایل به‌طور خودکار خوانده نمی‌شود (هیچ وابستگیِ .env در پروژه نیست).
# متغیرها را در shell export کنید یا در سرویس‌دهنده (systemd / supervisor / IIS / Docker)
# به‌عنوان Environment تنظیم کنید:
#
#   Linux/mac :  set -a; source .env; set +a;  python wsgi.py
#   Windows   :  for /f "usebackq tokens=1,* delims==" %%A in (".env") do set "%%A=%%B"
#                python wsgi.py
#
# روی سرور واقعی نسخهٔ deploy/nobatin.env.template را بردارید؛ این نسخه پیش‌فرض‌های
# محلی دارد. چند تنظیم در production «اجباری» است: اگر درست نباشد برنامه بالا
# نمی‌آید (نه هشدار، ردِ صریح) — آن‌ها را با ⛔ علامت زده‌ایم.

# ---------- محیط اجرا ----------
# development → پیش‌فرضِ python app.py (کد مستر و درگاه آزمایشی فعال)
# production  → پیش‌فرضِ python wsgi.py؛ بدون NOBATIN_SECRET برنامه بالا نمی‌آید
NOBATIN_ENV=production

# ⛔ کلید رمز کوکی جلسات. حتماً عوض شود؛ مثلاً:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NOBATIN_SECRET=

# نام فایل دیتابیس SQLite داخل پوشهٔ instance (پیش‌فرض: nobatin.db)
NOBATIN_DB=nobatin.db

# اگر سایت پشت HTTPS اجرا می‌شود: ۱ = کوکی ورود فقط با HTTPS ارسال می‌شود
# (روی http محلی آن را ۰ بگذارید، وگرنه ورود کار نمی‌کند)
NOBATIN_COOKIE_SECURE=0

# اگر پشت nginx/پروکسی هستید: ۱ = IP و http/https واقعی از سرصفحه‌های X-Forwarded-* خوانده
# می‌شود (سقف‌های IP ورود و کوکی Secure به همان IP/پروتکل وابسته‌اند).
# فقط وقتی روشن کنید که دقیقاً یک پروکسی جلوی اپ باشد؛ وگرنه IP جعلی پذیرفته می‌شود.
NOBATIN_BEHIND_PROXY=0

# ---------- سرور ----------
# پیش‌فرض waitress (python wsgi.py) هم 127.0.0.1 است: این برنامه برای اجرا جلوی
# پروکسی TLS ساخته شده. 0.0.0.0 فقط وقتی که عمداً بی‌nginx سرو می‌کنید — در آن
# حالت کوکی Secure، HSTS و سقف‌های نرخِ IP همه بی‌معنا می‌شوند.
NOBATIN_HOST=127.0.0.1
NOBATIN_PORT=8080
NOBATIN_THREADS=8

# ⛔ هاست‌های مجاز (جداسازی با ویرگول). در production خالی = برنامه بالا نمی‌آید؛
# در توسعه خالی یعنی هر Host هدری باور می‌شود، و مهاجم با آن پیوند بازگشت و
# متن پیامک‌ها را به دامنهٔ خودش می‌سازد.
# قاعدهٔ تطابق: نام باید دقیقاً یکی از این‌ها باشد. «.example.com» یعنی خودِ دامنه
# و همهٔ زیردامنه‌ها. localhost و 127.0.0.1 خودکار اضافه می‌شوند تا بررسی سلامت با
# curl روی همان ماشین کار کند. نشانی IPv6 داخل [] پذیرفته نمی‌شود (محدودیت werkzeug).
NOBATIN_TRUSTED_HOSTS=example.com,www.example.com

# ساعت عمر کوکی نشست (پیش‌فرض: ۱۲ در production، ۷۲۰ در توسعه)
NOBATIN_SESSION_HOURS=12

# ---------- دادهٔ نمونه و اولین مدیر ----------
# در production پیش‌فرض خاموش است؛ =1 فقط اگر واقعاً می‌خواهید حساب‌های دمو بسازید
NOBATIN_SEED=0
# اولین حساب مدیر (ورود با پیامک واقعی؛ رمز نمی‌خواهد)
NOBATIN_ADMIN_MOBILE=
NOBATIN_ADMIN_NAME=مدیر نوبتین

# ---------- ورود با کد یک‌بارمصرف ----------
# ۱ = کد ثابت ۱۲۳۴۵ برای همهٔ شماره‌ها (فقط توسعه؛ در production ممنوع است)
NOBATIN_OTP_MASTER=0
# ثانیه فاصلهٔ دو درخواست کد برای یک شماره
NOBATIN_OTP_COOLDOWN=60
# سقف درخواست کد برای هر شماره در یک ساعت
NOBATIN_OTP_MAX_MOBILE=5
# سقف درخواست کد از هر IP در یک ساعت
NOBATIN_OTP_MAX_IP=12
# سقف کدهای اشتباه برای یک شماره در ۳۰ دقیقه (پس از آن قفل موقت)
NOBATIN_OTP_MAX_ATTEMPTS=12

# ---------- پیامک ----------
# log        → فقط در جدول sms_log ثبت می‌شود (پیش‌فرض؛ هیچ هزینه‌ای ندارد)
# kavenegar  → ارسال واقعی؛ نیازمند توکن و شمارهٔ فرستنده
NOBATIN_SMS_PROVIDER=log
KAVENEGAR_KEY=
KAVENEGAR_SENDER=
# در production پیش‌فرض ۱: متنِ OTPِ ثبت‌شده در sms_log از کدِ زنده پاک‌سازی می‌شود،
# چون پنل «پیامک‌ها» در دسترس مدیر است و نباید رمزِ در جریانِ ورود آنجا خوانده شود.
# =0 فقط برای عیب‌یابی محلی (پیش‌فرض توسعه خودکار ۰ است).
NOBATIN_SMS_MASK_OTP=0

# ---------- پرداخت ----------
# sandbox → صفحهٔ درگاه آزمایشی داخل همین پروژه (routes/gateway.py + core/gateway.py)
# برای درگاه واقعی فقط همان دو فایل با سرویس بانک عوض می‌شوند؛ جدول تراکنش‌ها و
# وضعیت‌ها (created/pending/success/failed/cancelled) همان می‌ماند.
NOBATIN_PAYMENT_PROVIDER=sandbox
# ⛔ درگاه آزمایشی در production: هر کاربر واردشده می‌تواند «پرداخت موفق» بزند و
# نوبت رایگان قطعی کند، پس بدون این اجازه اپ بالا نمی‌آید. برای محیط نمایشی/دموی
# زنده آگاهانه =1 بگذارید؛ برای پول واقعی =0 بگذارید و درگاه وصل کنید.
NOBATIN_ALLOW_SANDBOX=0

# همهٔ فرم‌های POST توکن ضد CSRF می‌برند و بی‌توکن ۴۰۰ می‌گیرند. این تنها جا برای استثناست:
# endpointهایی که یک سرویس بیرونی (مثل بازگشت سرور‌به‌سرور درگاه پرداخت واقعی) POST می‌کند
# و فرمِ ما نیست. تا درگاه واقعی نگرفته‌اید خالی بگذارید — درگاه آزمایشی خودِ پروژه
# فرمِ ما است، توکن می‌فرستد و اینجا بی‌نیاز است. (پاک کردن این تنظیم لازم نیست؛
# مسیرهای بیرونیِ بی‌توکن یعنی دورزدن CSRF، پس فقط فهرستِ دقیقاً لازم‌شده بگذارید.)
NOBATIN_CSRF_EXEMPT=

# ---------- کارهای زمان‌بندی‌شده ----------
# فاصلهٔ حداقلی اجرای خودکار یادآوری‌ها (دقیقه)؛ ۰ = خاموش
NOBATIN_REMINDER_MINUTES=10
# جاروی سبدها/نوبت‌های بی‌زمان در هر درخواست، حداکثر هر N ثانیه (۰ = فقط با --expiry)
NOBATIN_HOUSEKEEPING_SECONDS=20

# ---------- بار و کش ----------
# کش کوتاه دسته/استان/شهر/تنظیمات (ثانیه)؛ ۰ = خاموش. نوشتن روی همان جدول‌ها
# کش را بی‌اعتبار می‌کند، ولی در چند worker پروسه‌های دیگر حداکثر تا همین عمر
# دادهٔ کهنه می‌بینند.
NOBATIN_CACHE_TTL=15
# کش فایل‌های ایستا روی مرورگر (ثانیه)؛ نشانی‌ها با اثر انگشت محتوا می‌آیند
NOBATIN_STATIC_MAX_AGE=604800
# چند بار تلاش دوباره برای نوشتن وقتی قفل پایگاه داده شلوغ است (busy)
NOBATIN_TX_RETRIES=4

# ---------- سقف‌های نرخ (ضد ربات و هجوم ساده) ----------
# شمارنده‌ها روی خودِ دیتابیس‌اند، پس بین workerها هم مشترک می‌مانند.
# ۰ = آن سقف خاموش (فقط برای آزمون).
NOBATIN_LIMIT_WRITES_PER_MIN=90      # هر درخواست POST/PUT/DELETE از هر IP، در دقیقه
NOBATIN_LIMIT_HOLDS_PER_HOUR=120     # قفل ساعت سبد خرید، به ازای هر کاربر
NOBATIN_LIMIT_BOOKINGS_PER_HOUR=30   # ساخت نوبت، به ازای هر کاربر
NOBATIN_LIMIT_BIZ_PER_DAY=10         # ثبت کسب‌وکار از هر IP در روز
# سقف حجم بدنهٔ درخواست (کило‌بایت)؛ فرم‌ها چند کیلوبایت‌اند
NOBATIN_MAX_BODY_KB=1024

# ---------- سرصفحه‌های امنیتی ----------
# HSTS بر حسب ثانیه (پیش‌فرض production: ۳۱۵۳۶۰۰۰ = یک سال)
NOBATIN_HSTS_SECONDS=31536000
# CSP؛ خالی = مقدار امن خودِ برنامه (اسکریپت درون‌خطی ممنوع، همه‌چیز از خودِ مبنا).
# style-src درون‌خطی لازم است: رنگ هر کسب‌وکار با متغیر --biz-hue ست می‌شود.
NOBATIN_CSP=

# ---------- سلامت و لاگ ----------
NOBATIN_HEALTHZ=1
# فقط از این IPها (پیش‌فرض loopback). برای بررسی از بیرون یک توکن بلند بگذارید و
# از سرصفحه بفرستید (نشانیِ ?token=… در لاگ nginx می‌نشیند، سرصفحه نه):
#   curl -H "X-Health-Token: $NOBATIN_HEALTHZ_TOKEN" https://example.com/healthz
NOBATIN_HEALTHZ_ALLOW=127.0.0.1,::1
NOBATIN_HEALTHZ_TOKEN=
# فایل لاگ چرخشی (۵×۴ مگابایت). خالی = فقط stdout (journal/systemd می‌بیندش)
NOBATIN_LOG_FILE=
NOBATIN_LOG_LEVEL=INFO
